# Laravel production environment
APP_NAME="Talaye Shalizar API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
PUBLIC_DISK_URL=https://cdn.example.com

# MariaDB/MySQL only; PostgreSQL is not used.
DB_CONNECTION=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=talaye_shalizar
DB_USERNAME=talaye_app
DB_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
DB_ENGINE=InnoDB
DB_TIMEZONE=+00:00

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=180
DB_QUEUE_AFTER_COMMIT=true
QUEUE_FAILED_DRIVER=database-uuids
FILESYSTEM_DISK=public

LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# Required for real OTP delivery. Keep secrets only in the server's .env file.
SMS_DRIVER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_VERIFICATION_TEMPLATE=verify
KAVENEGAR_PASSWORD_RESET_TEMPLATE=password-reset
